{
  "name": "@lingora/observability",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-safe structured logging facade for Lingora — app code imports only this package, never a transport directly.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./expo": "./src/expo-file-system.transport.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "expo-file-system": ">=57.0.0"
  },
  "peerDependenciesMeta": {
    "expo-file-system": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "expo-file-system": "~57.0.0",
    "vitest": "^3.2.4"
  }
}
