rules_version = '2';

// Every synced record lives under users/{uid}/{tableName}/{recordId} — see
// apps/mobile/lib/firestoreSyncBackend.ts. One rule: a user can only read/write their own data.
// Nothing else (API keys, ai_cache, sync_queue) is ever written here — see
// packages/database/src/backup.ts's TABLE_ORDER for exactly what's in scope.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
