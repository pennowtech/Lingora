{
  "name": "@lingora/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "node ./scripts/run-android.js",
    "android:isolated": "expo start --android --port 8090",
    "build:android:development": "npx eas-cli@latest build --platform android --profile development",
    "build:android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "build:android:production": "npx eas-cli@latest build --platform android --profile production --non-interactive",
    "ios": "expo run:ios",
    "i18n:check": "node ./scripts/check-i18n.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lingora/ai": "workspace:*",
    "@lingora/core": "workspace:*",
    "@lingora/database": "workspace:*",
    "@lingora/observability": "workspace:*",
    "@lingora/types": "workspace:*",
    "@react-native-firebase/app": "^26.0.0",
    "@react-native-firebase/auth": "^26.0.0",
    "@react-native-firebase/firestore": "^26.0.0",
    "@tanstack/react-query": "^5.90.5",
    "babel-preset-expo": "~57.0.3",
    "base64-js": "^1.5.1",
    "expo": "^57.0.19",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.16",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "^57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "^57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-notifications": "^57.0.16",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-share-intent": "^8.0.1",
    "expo-sharing": "^57.0.17",
    "expo-speech": "~57.0.2",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.3",
    "fzstd": "^0.1.1",
    "i18next": "^26.3.6",
    "jszip": "^3.10.1",
    "liquidjs": "^10.27.2",
    "lucide-react-native": "^1.33.0",
    "react": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-google-signin": "^1.3.0",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@react-native-community/cli": "latest",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "process-text-intent",
          "react-native-nitro-google-signin"
        ]
      }
    }
  }
}
