# Copy to packages/ai/.env (gitignored — never commit real keys) to run the opt-in live provider
# tests (src/providers/*.live.test.ts) against real APIs. Each test file checks its own key and
# skips itself (describe.skipIf) if that key is absent, so it's fine to only set the ones you have.
#
#   cp packages/ai/.env.example packages/ai/.env
#   # edit in your real key(s)
#   pnpm --filter @lingora/ai run test

OPENAI_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPL_API_KEY=
